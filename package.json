{
  "name": "trueforge-context-agent",
  "displayName": "NotTheLeast",
  "description": "NotTheLeast — A VS Code AI coding assistant powered by TrueForge.",
  "version": "0.1.0",
  "private": true,
  "publisher": "nottheleast",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:nottheleast.chat",
    "onView:nottheleast.activity",
    "onView:nottheleast.tools",
    "onView:nottheleast.diagnostics",
    "onView:nottheleast.context",
    "onCommand:agent.openPanel",
    "onCommand:agent.inlineEdit"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "nottheleast",
          "title": "NotTheLeast",
          "icon": "resources/nottheleast.svg"
        }
      ]
    },
    "views": {
      "nottheleast": [
        {
          "type": "webview",
          "id": "nottheleast.chat",
          "name": "Chat"
        },
        {
          "type": "webview",
          "id": "nottheleast.activity",
          "name": "Agent Activity"
        },
        {
          "type": "webview",
          "id": "nottheleast.tools",
          "name": "Tool Execution"
        },
        {
          "type": "webview",
          "id": "nottheleast.diagnostics",
          "name": "Diagnostics"
        },
        {
          "type": "webview",
          "id": "nottheleast.context",
          "name": "Context Assembly"
        }
      ]
    },
    "commands": [
      {
        "command": "agent.openPanel",
        "title": "NotTheLeast: Open Chat"
      },
      {
        "command": "agent.inlineEdit",
        "title": "NotTheLeast: Inline Edit"
      },
      {
        "command": "agent.undoEdit",
        "title": "NotTheLeast: Undo Approved Edit"
      },
      {
        "command": "agent.copyMcpCredentials",
        "title": "NotTheLeast: Copy MCP Connector Credentials"
      },
      {
        "command": "agent.copyDiagnostics",
        "title": "NotTheLeast: Copy Diagnostics Report"
      },
      {
        "command": "nottheleast.showActivity",
        "title": "NotTheLeast: Show Agent Activity"
      },
      {
        "command": "nottheleast.showTools",
        "title": "NotTheLeast: Show Tool Execution"
      },
      {
        "command": "nottheleast.showDiagnostics",
        "title": "NotTheLeast: Show Diagnostics"
      },
      {
        "command": "nottheleast.showContext",
        "title": "NotTheLeast: Show Context Assembly"
      }
    ],
    "keybindings": [
      {
        "command": "agent.inlineEdit",
        "key": "ctrl+alt+i",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "NotTheLeast",
      "properties": {
        "trueforge.baseUrl": {
          "type": "string",
          "default": "http://localhost:8790",
          "description": "NotTheLeast: Local TrueForge agent server URL."
        },
        "trueforge.agentName": {
          "type": "string",
          "default": "trueforge-extension-agent",
          "description": "NotTheLeast: Configured TrueForge agent name used for chat sessions."
        },
        "trueforge.mcpPort": {
          "type": "number",
          "default": 8765,
          "minimum": 1,
          "maximum": 65535,
          "description": "NotTheLeast: Loopback port used by the extension MCP server."
        },
        "trueforge.contextBudget": {
          "type": "number",
          "default": 4000,
          "minimum": 200,
          "description": "NotTheLeast: Combined token budget for Context Manager and retrieved evidence."
        },
        "nottheleast.inactivityWarningSeconds": {
          "type": "number",
          "default": 15,
          "minimum": 5,
          "description": "NotTheLeast: Seconds of silence before showing an inactivity warning."
        },
        "nottheleast.enableGpuTelemetry": {
          "type": "boolean",
          "default": true,
          "description": "NotTheLeast: Attempt to read NVIDIA GPU metrics via nvidia-smi."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@truefoundry/trueforge-sdk": "0.185.0",
    "@types/sql.js": "^1.4.11",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sql.js": "^1.15.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8"
  }
}
