{
  "name": "trueforge-context-agent",
  "displayName": "TrueForge Context Agent",
  "description": "A VS Code coding agent shell built around TrueForge.",
  "version": "0.1.0",
  "private": true,
  "publisher": "trueforge-context-agent",
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:trueforge.contextView",
    "onCommand:agent.openPanel",
    "onCommand:agent.inlineEdit"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "trueforge",
          "title": "TrueForge",
          "icon": "resources/trueforge.svg"
        }
      ]
    },
    "views": {
      "trueforge": [
        {
          "type": "webview",
          "id": "trueforge.contextView",
          "name": "Context Agent"
        }
      ]
    },
    "commands": [
      {
        "command": "agent.openPanel",
        "title": "TrueForge: Open Agent Panel"
      },
      {
        "command": "agent.inlineEdit",
        "title": "TrueForge: Inline Edit"
      }
    ],
    "keybindings": [
      {
        "command": "agent.inlineEdit",
        "key": "ctrl+alt+i",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "TrueForge Context Agent",
      "properties": {
        "trueforge.baseUrl": {
          "type": "string",
          "default": "http://localhost:8790",
          "description": "Local TrueForge agent server URL."
        },
        "trueforge.agentName": {
          "type": "string",
          "default": "forge-demo-agent",
          "description": "Configured TrueForge agent name used for chat sessions."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@truefoundry/trueforge-sdk": "^0.183.0",
    "@types/sql.js": "^1.4.11",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sql.js": "^1.15.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8"
  }
}
